# Copy to .env and adjust. Every setting comes from environment variables, and
# this file is the one list of them. Compose passes every variable in .env to
# the app and migrate services (env_file), and reads the "Compose" section
# itself.

# --- App ---

# Postgres connection for tools run on the host (`pnpm dev`, `pnpm start`,
# `pnpm db:migrate`). Matches the `db` service in compose.yaml and DB_PORT.
# Inside Compose, the app and migrate services use db:5432 instead.
DATABASE_URL=postgres://attendance:attendance@localhost:5432/attendance

# The workplace time zone (IANA name). Days and weeks follow this zone, and
# so does the backup schedule.
WORKPLACE_TIME_ZONE=Europe/London

# --- Compose ---

# The app image, ${IMAGE}:${IMAGE_TAG}. IMAGE defaults to the GHCR
# repository. Locally, `docker compose up --build` builds it as the `local`
# tag. On the Pi, IMAGE_TAG is the release to run (e.g. v1.2.0); see README
# "Production stack" for the deploy commands.
# IMAGE=ghcr.io/samuelrendl/attendance-system
IMAGE_TAG=local

# Postgres credentials for the db, migrate, app and backup services. Use a
# real password in production (and update DATABASE_URL above to match).
POSTGRES_USER=attendance
POSTGRES_PASSWORD=attendance
POSTGRES_DB=attendance

# Host ports, bound to 127.0.0.1 only (Tailscale Serve proxies the app port).
DB_PORT=5432
APP_PORT=3000

# Backups: pg_dump files (restore with pg_restore) written to BACKUP_DIR on
# the host on a cron schedule (in WORKPLACE_TIME_ZONE), keeping the newest
# BACKUP_KEEP.
BACKUP_DIR=./backups
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_KEEP=14
