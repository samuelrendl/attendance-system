# Copy to .env and adjust. Every setting comes from environment variables.

# Postgres connection. Matches the `db` service in compose.yaml.
DATABASE_URL=postgres://attendance:attendance@localhost:5432/attendance

# The workplace time zone (IANA name). Days and weeks follow this zone.
WORKPLACE_TIME_ZONE=Europe/London

# Signs the Admin's session cookies. At least 32 characters; generate one with
# `openssl rand -base64 32`. Changing it logs the Admin out.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# The URL the app is served at. On the Pi that's https://<host>.ts.net; an
# https:// URL makes the session cookie Secure.
BETTER_AUTH_URL=http://localhost:3000

# The Admin created on the first start, when no Admin exists yet. Later starts
# ignore them: change the password with `pnpm admin:reset-password` instead.
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me-please
